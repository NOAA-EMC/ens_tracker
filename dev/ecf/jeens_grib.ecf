module reset
export target=wcoss2
module use /lfs/h2/emc/ens/noscrub/hananeh.jafary/ens_package_20260512/modulefiles
module load ${target}.lua
module list

export JASPER_PATH=/apps/spack/jasper/2.0.25/intel/19.1.3.304/sjib74krrorkyczqpqah4tvewmlnqdx4/lib64
export NETCDF_PATH=/apps/prod/hpc-stack/intel-19.1.3.304/netcdf/4.7.4/lib
export HDF5_PATH=/apps/prod/hpc-stack/intel-19.1.3.304/hdf5/1.10.6/lib
export LD_LIBRARY_PATH=${JASPER_PATH}:${NETCDF_PATH}:${HDF5_PATH}:${LD_LIBRARY_PATH}

export model=ens_tracker
export cyc=00
export envir=prod
export job=eens
export COMROOT=/lfs/h2/emc/ptmp/hananeh.jafary/com
export DATAROOT=/lfs/h2/emc/ptmp/hananeh.jafary
export KEEPDATA=YES

export PACKAGEHOME=/lfs/h2/emc/ens/noscrub/hananeh.jafary/ens_package_20260512

module load PrgEnv-intel/$PrgEnv_intel_ver
module load intel/$intel_ver
module load craype/$craype_ver

module load hdf5/$hdf5_ver
module load netcdf/$netcdf_ver

module load g2/$g2_ver
module load jasper/$jasper_ver
module load libpng/$libpng_ver
module load zlib/$zlib_ver

module load w3emc/$w3emc_ver
module load bacio/$bacio_ver

module load libjpeg/$libjpeg_ver
module load grib_util/1.2.3
module load wgrib2/2.0.8

module load cray-pals/$cray_pals_ver
module list

# CALL executable job script here
${PACKAGEHOME}/dev/jobs/JEENS_GRIB

